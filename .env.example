# FASHINERY Production Environment Variables
# Configure these variables in your hosting environment (Cloud Run, Firebase App Hosting, or Secret Manager)

# Port configuration (automatically injected by Cloud Run / App Hosting)
PORT=3000

# App URL (e.g., https://fashinery.com or Cloud Run URL)
APP_URL=

# Optional: Production custom domains for CORS (comma-separated if multiple)
ALLOWED_ORIGINS=

# Razorpay Gateway Server Secrets
# These secrets MUST ONLY exist on the server.
# NEVER expose RAZORPAY_KEY_SECRET or RAZORPAY_WEBHOOK_SECRET to the client, browser, or Git repository.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
