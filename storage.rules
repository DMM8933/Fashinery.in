rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isSignedIn() {
      return request.auth != null;
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        (firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.role == 'superadmin' &&
         firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.isActive == true) ||
        request.auth.token.email == 'dheeraj8933@gmail.com'
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        (firestore.exists(/databases/(default)/documents/admins/$(request.auth.uid)) &&
         firestore.get(/databases/(default)/documents/admins/$(request.auth.uid)).data.isActive == true) ||
        request.auth.token.email == 'dheeraj8933@gmail.com'
      );
    }

    // Helper for validating image uploads
    function isValidImage() {
      return request.resource.size < 5 * 1024 * 1024 // 5MB limit
          && request.resource.contentType in ['image/jpeg', 'image/png', 'image/webp'];
    }

    // Public read for fashion images, product catalogs, banners and media assets
    // Writes (uploads, updates, deletes) reserved for authorized administrators and staff
    match /products/{productId}/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.method == 'DELETE' || isValidImage());
    }

    // Categories
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.method == 'DELETE' || isValidImage());
    }

    // Banners
    match /banners/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.method == 'DELETE' || isValidImage());
    }

    // Community & Styling Gallery images (#FashineryWomen)
    match /community-gallery/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.method == 'DELETE' || isValidImage());
    }

    match /{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin() && (request.method == 'DELETE' || isValidImage());
    }
  }
}
