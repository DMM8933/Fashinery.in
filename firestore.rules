rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All (Fortress Baseline)
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================================================
    // GLOBAL HELPERS & HARDENING
    // ==================================================
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isVerified() { return isSignedIn() && request.auth.token.email_verified == true; }
    
    // ID Validation (ID Poisoning Guard)
    function isValidId(id) { return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); }
    
    // Attribute-Based Access Control (RBAC) via secure admins collection
    // Custom Claims (admin: true) are the primary source, fallback to admins collection
    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true) ||
        (request.auth.token.email == 'dheeraj8933@gmail.com' && isVerified())
      );
    }

    function isSuperAdmin() {
      return isSignedIn() && (
        request.auth.token.admin == true ||
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin' &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true) ||
        (request.auth.token.email == 'dheeraj8933@gmail.com' && isVerified())
      );
    }

    // Schema Validation Helpers (Anti-Update-Gap)
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    function isValidOrder(data) {
      return data.keys().hasAll(['total', 'items', 'orderStatus', 'paymentStatus']) &&
             data.total is number && data.total >= 0 &&
             data.items is list && data.items.size() > 0 &&
             data.orderStatus is string && data.paymentStatus is string &&
             data.keys().hasOnly(['id', 'orderNumber', 'userId', 'customerName', 'customerEmail', 'customerPhone', 'shippingAddress', 'items', 'subtotal', 'discount', 'shippingCharge', 'total', 'couponCode', 'paymentMethod', 'paymentStatus', 'orderStatus', 'createdAt', 'updatedAt', 'notes', 'razorpayOrderId', 'razorpayPaymentId', 'razorpaySignature', 'paidAt', 'cancelledAt', 'cancellationReason', 'customerCancellationReason', 'cancellationDetails', 'cancelledBy', 'trackingUrl', 'courierPartner', 'trackingNumber', 'courier', 'returnReason', 'returnNotes', 'returnType', 'returnRequestedAt']);
    }

    function isValidProduct(data) {
      return data.keys().hasAll(['name', 'mrp', 'sellingPrice', 'stock', 'categoryId']) &&
             data.name is string && data.name.size() > 0 &&
             data.sellingPrice is number && data.sellingPrice >= 0 &&
             data.stock is number && data.stock >= 0;
    }

    // ==================================================
    // COLLECTION RULES
    // ==================================================

    // 1. Connection Health Check
    match /test/{docId} {
      allow read: if true;
    }

    // 2. Admins Collection (RBAC Source of Truth)
    match /admins/{adminId} {
      allow get: if isOwner(adminId) || isAdmin();
      allow list: if isAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // 3. Customer Users (Profiles & PII)
    // Enforces role lockdown and PII isolation
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && 
        incoming().keys().hasAll(['uid', 'role', 'createdAt']) &&
        incoming().role == 'customer' &&
        !incoming().keys().hasAny(['isBlocked', 'isAdmin']);
      allow update: if (isOwner(userId) && (
        !incoming().diff(existing()).affectedKeys().hasAny(['role', 'isAdmin', 'uid', 'id', 'createdAt']) &&
        incoming().role == 'customer'
      )) || isAdmin();
      allow delete: if isAdmin();
    }

    // Alias for customer profile
    match /customers/{customerId} {
      allow get: if isOwner(customerId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(customerId) && incoming().role == 'customer';
      allow update: if (isOwner(customerId) && !incoming().diff(existing()).affectedKeys().hasAny(['role', 'uid'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // 4. Phone Lookup (Identity Mapping)
    // Public get allowed for login flow existence checks
    match /phone_lookup/{phone} {
      allow get: if true; 
      allow list: if isAdmin();
      allow create, update: if isSignedIn() && (incoming().uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // 5. Products (Public Catalog)
    match /products/{productId} {
      allow read: if isValidId(productId);
      allow write: if isAdmin() && isValidProduct(incoming());
    }

    // 6. Categories (Public)
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 7. Orders (Purchase Records)
    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (isOwner(resource.data.userId) || (resource.data.userId == 'guest') || isAdmin());
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      
      // Order Creation validation (The Master Gate)
      allow create: if isValidId(orderId) &&
        isValidOrder(incoming()) &&
        incoming().paymentStatus == 'Pending' &&
        (incoming().orderStatus in ['Pending Payment', 'Confirmed', 'Placed']) &&
        !incoming().keys().hasAny(['razorpayPaymentId', 'razorpaySignature', 'paidAt']) &&
        (
          (isSignedIn() && incoming().userId == request.auth.uid) ||
          (!isSignedIn() && incoming().userId == 'guest') ||
          isAdmin()
        );

      // Tiered Update Logic (Actions)
      allow update: if (isAdmin() && isValidOrder(incoming())) || (
        isSignedIn() && isOwner(existing().userId) && isValidOrder(incoming()) && (
          // Action: Customer Cancel
          (incoming().orderStatus == 'Cancelled' && 
           existing().orderStatus in ['Placed', 'Confirmed', 'Processing', 'Pending Payment'] &&
           incoming().diff(existing()).affectedKeys().hasOnly([
             'orderStatus', 'cancellationReason', 'customerCancellationReason', 'cancellationDetails', 'cancelledAt', 'cancelledBy', 'notes', 'updatedAt'
           ])) ||
          // Action: Customer Return Request
          (incoming().orderStatus in ['Return Requested', 'Exchange Requested'] &&
           existing().orderStatus == 'Delivered' &&
           incoming().diff(existing()).affectedKeys().hasOnly([
             'orderStatus', 'returnReason', 'returnNotes', 'returnType', 'returnRequestedAt', 'updatedAt'
           ]))
        )
      );
      
      allow delete: if isAdmin() && resource.data.orderStatus == 'Cancelled';
    }

    // 8. Coupons (Discount Verification)
    match /coupons/{couponId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        incoming().diff(existing()).affectedKeys().hasOnly(['usedCount', 'updatedAt']) &&
        incoming().usedCount == existing().usedCount + 1
      );
    }

    // 9. Banners & Homepage
    match /banners/{id} { allow read: if true; allow write: if isAdmin(); }
    match /homepageContent/{id} { allow read: if true; allow write: if isAdmin(); }
    match /homepage/{id} { allow read: if true; allow write: if isAdmin(); }
    match /siteSettings/{id} { allow read: if true; allow write: if isAdmin(); }
    match /settings/{id} { allow read: if true; allow write: if isAdmin(); }

    // 10. Reviews (Moderated)
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn(); // Restriction: Must be logged in to review
      allow update, delete: if isAdmin();
    }

    // 11. Policies & Content
    match /policies/{id} { allow read: if true; allow write: if isAdmin(); }
    match /faqs/{id} { allow read: if true; allow write: if isAdmin(); }
    
    // 12. Interactions & Inquiries
    match /newsletter/{id} {
      allow read: if isAdmin();
      allow create: if incoming().email is string && incoming().email.size() >= 5;
      allow update, delete: if isAdmin();
    }
    match /contacts/{id} {
      allow read: if isAdmin();
      allow create: if incoming().message is string && incoming().message.size() >= 5;
      allow update, delete: if isAdmin();
    }
    
    // 13. Media Assets
    match /media/{id} {
      allow read: if true;
      allow write: if isAdmin() && incoming().keys().hasAll(['url']) && incoming().url is string;
    }
  }
}
