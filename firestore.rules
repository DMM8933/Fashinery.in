rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny All Catch-All (Fortress Baseline)
    match /{document=**} {
      allow read, write: if false;
    }

    // ==================================================
    // GLOBAL SECURITY & AUTHENTICATION HELPERS
    // ==================================================
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Role validation: Verified against the secure admins collection
    // No administrator emails are exposed in the security rules
    function isSuperAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'superadmin' &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true) ||
        (exists(/databases/$(database)/documents/admins/dheeraj8933) &&
         request.auth.token.email_verified == true &&
         get(/databases/$(database)/documents/admins/dheeraj8933).data.email == request.auth.token.email)
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        (exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.isActive == true) ||
        (exists(/databases/$(database)/documents/admins/dheeraj8933) &&
         request.auth.token.email_verified == true &&
         get(/databases/$(database)/documents/admins/dheeraj8933).data.email == request.auth.token.email)
      );
    }

    // ==================================================
    // ORDER VALIDATION & ACTION HELPERS
    // ==================================================
    function isValidOrderCreate(orderId) {
      return orderId is string && orderId.size() >= 5 && orderId.size() <= 64 &&
        // Payment status on create must ALWAYS be Pending — client can NEVER mark Paid on create
        request.resource.data.paymentStatus == 'Pending' &&
        // Initial order status must be unconfirmed or pending
        (request.resource.data.orderStatus in ['Pending Payment', 'Confirmed', 'Placed']) &&
        // Valid payment methods only
        (request.resource.data.paymentMethod in ['Cash on Delivery', 'UPI / Online Payment', 'Razorpay / Online']) &&
        // Client can NEVER supply verified payment parameters on order creation
        !request.resource.data.keys().hasAny(['razorpayPaymentId', 'razorpaySignature', 'paidAt']) &&
        // Identity validation: user can only bind to own UID, unauthenticated to guest
        (
          (isSignedIn() && request.resource.data.userId == request.auth.uid) ||
          (!isSignedIn() && request.resource.data.userId == 'guest') ||
          isAdmin()
        ) &&
        // Financial figures validation: must be non-negative numbers
        request.resource.data.total is number && request.resource.data.total >= 0 &&
        request.resource.data.subtotal is number && request.resource.data.subtotal >= 0 &&
        request.resource.data.discount is number && request.resource.data.discount >= 0 &&
        request.resource.data.shippingCharge is number && request.resource.data.shippingCharge >= 0 &&
        // Items list must be non-empty
        request.resource.data.items is list && request.resource.data.items.size() > 0 &&
        // Customer contact information
        request.resource.data.customerName is string && request.resource.data.customerName.size() >= 2 &&
        request.resource.data.customerPhone is string && request.resource.data.customerPhone.size() >= 10 &&
        request.resource.data.customerEmail is string && request.resource.data.customerEmail.size() >= 5 &&
        // Shipping address must be provided
        request.resource.data.shippingAddress is map;
    }

    // Customer cancellation: strictly restricted to cancelling own order with status 'Cancelled'
    // Customers can NEVER modify courierPartner, trackingUrl, or impersonate Admin cancellation
    function isCustomerCancelAction() {
      return isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        // Order must be in a cancellable status (not shipped, delivered, or already cancelled)
        (resource.data.orderStatus in ['Placed', 'Confirmed', 'Processing', 'Pending Payment']) &&
        // Permitted update keys only (trackingUrl and courierPartner are strictly excluded)
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'orderStatus', 'cancellationReason', 'customerCancellationReason', 'cancellationDetails', 'cancelledAt', 'cancelledBy', 'notes', 'updatedAt'
        ]) &&
        request.resource.data.orderStatus == 'Cancelled' &&
        // Customer can only set cancelledBy to customer, NEVER admin
        (request.resource.data.cancelledBy in ['customer', 'Customer']) &&
        // Invariant protection: Financial amounts, paymentStatus, paymentMethod, items, and createdAt MUST NOT CHANGE
        request.resource.data.paymentStatus == resource.data.paymentStatus &&
        request.resource.data.paymentMethod == resource.data.paymentMethod &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.subtotal == resource.data.subtotal &&
        request.resource.data.discount == resource.data.discount &&
        request.resource.data.shippingCharge == resource.data.shippingCharge &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    // Customer return/exchange request: strictly for delivered orders
    function isCustomerReturnAction() {
      return isSignedIn() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == resource.data.userId &&
        (resource.data.orderStatus == 'Delivered') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'orderStatus', 'returnReason', 'returnNotes', 'returnType', 'returnRequestedAt', 'updatedAt'
        ]) &&
        (request.resource.data.orderStatus in ['Return Requested', 'Exchange Requested']) &&
        request.resource.data.paymentStatus == resource.data.paymentStatus &&
        request.resource.data.paymentMethod == resource.data.paymentMethod &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.subtotal == resource.data.subtotal &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    // Server-side payment verification: Only allowed when transitioning a Pending Payment Razorpay order
    // to Confirmed & Paid with verified Razorpay transaction credentials
    function isServerVerifiedPaymentUpdate() {
      return resource.data.paymentStatus == 'Pending' &&
        resource.data.orderStatus == 'Pending Payment' &&
        resource.data.paymentMethod == 'UPI / Online Payment' &&
        (resource.data.razorpayOrderId is string && resource.data.razorpayOrderId.size() > 5) &&
        request.resource.data.paymentStatus == 'Paid' &&
        request.resource.data.orderStatus == 'Confirmed' &&
        (request.resource.data.razorpayPaymentId is string && request.resource.data.razorpayPaymentId.size() > 5) &&
        request.resource.data.razorpayOrderId == resource.data.razorpayOrderId &&
        (request.resource.data.razorpaySignature is string && request.resource.data.razorpaySignature.size() >= 32) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymentStatus', 'orderStatus', 'razorpayPaymentId', 'razorpayOrderId', 'razorpaySignature', 'paidAt', 'updatedAt', 'notes'
        ]) &&
        // Total immutability of pricing, customer info, and line items
        request.resource.data.total == resource.data.total &&
        request.resource.data.subtotal == resource.data.subtotal &&
        request.resource.data.discount == resource.data.discount &&
        request.resource.data.shippingCharge == resource.data.shippingCharge &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.createdAt == resource.data.createdAt &&
        request.resource.data.paymentMethod == resource.data.paymentMethod &&
        request.resource.data.customerEmail == resource.data.customerEmail &&
        request.resource.data.customerPhone == resource.data.customerPhone;
    }

    // Server-side payment failure registration
    function isServerPaymentFailedUpdate() {
      return resource.data.paymentStatus == 'Pending' &&
        request.resource.data.paymentStatus == 'Failed' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'paymentStatus', 'updatedAt', 'notes'
        ]) &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.subtotal == resource.data.subtotal &&
        request.resource.data.userId == resource.data.userId &&
        request.resource.data.items == resource.data.items &&
        request.resource.data.createdAt == resource.data.createdAt;
    }

    // ==================================================
    // COLLECTION RULES
    // ==================================================

    // Health check & connection validation probe
    match /test/{docId} {
      allow read: if true;
    }

    // Admins Collection:
    // - Any signed-in user may read their own admin doc to verify their admin status
    // - Authorized admins can list and read admin accounts
    // - ONLY a verified Super Admin can create, modify, or delete admins
    // - No public registration or privilege elevation
    match /admins/{adminId} {
      allow get: if isSignedIn() && (
        request.auth.uid == adminId || 
        isAdmin()
      );
      allow list: if isAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // Customer Users Collection (Profiles & addresses)
    // - Regular customer registration creates a 'customer' role only
    // - Customers cannot self-assign an admin role or elevate privileges
    // - Non-admin users can only view their own profile; admins can view all
    // - UID and ID are strictly immutable
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && (
        !request.resource.data.keys().hasAny(['role', 'isAdmin']) || 
        request.resource.data.role == 'customer'
      );
      allow update: if (
        isOwner(userId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'uid', 'id']) &&
          (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'customer')
        )
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Phone Lookup Collection (Maps normalized 10-digit Indian phone to authEmail & UID for login/recovery)
    // - Individual document get is public to allow lookup during login/reset before auth
    // - Listing all records is restricted to administrators to prevent phone number scraping
    // - Authenticated users can write/update their own phone mapping
    match /phone_lookup/{phone} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Customers Collection (Alias for customer profiles)
    match /customers/{customerId} {
      allow get: if isOwner(customerId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(customerId) && (
        !request.resource.data.keys().hasAny(['role', 'isAdmin']) || 
        request.resource.data.role == 'customer'
      );
      allow update: if (
        isOwner(customerId) && (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'isAdmin', 'uid', 'id']) &&
          (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role == 'customer')
        )
      ) || isAdmin();
      allow delete: if isAdmin();
    }

    // Products Collection (Catalog)
    // Public read; strictly admin-only for add, edit, price, stock, SKU, delete
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories Collection
    // Public read; strictly admin-only write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Banners Collection
    // Public read; strictly admin-only write
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Homepage Content Collections (hero, promotions, featured sections)
    match /homepageContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /homepage/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Site Settings Collection (Branding, contact info, shipping rates)
    match /siteSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Policies Collection (Shipping, returns, refunds, privacy, terms)
    match /policies/{policyId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Coupons Collection (Discounts & Promo Codes)
    // Public read for discount verification; strictly admin-only write
    // Customers cannot create, delete, or modify discount values/expiry; only usedCount increment is allowed
    match /coupons/{couponId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usedCount', 'updatedAt']) &&
        request.resource.data.usedCount == resource.data.usedCount + 1
      );
    }

    // Orders Collection
    // - Customers can view their own orders; admins can view all orders
    // - Unauthenticated users cannot list orders or read other users' orders
    // - Order creation requires Pending payment status; no client can create order as Paid
    // - Status changes, tracking, fulfillment updates strictly admin-only
    // - Customer can only cancel or request return on their own orders
    // - Customers CANNOT change paymentStatus, total, items, razorpayPaymentId, or mark as Paid
    // - Order deletion strictly admin-only
    match /orders/{orderId} {
      allow get: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow list: if (isSignedIn() && resource.data.userId == request.auth.uid) || isAdmin();
      allow create: if isValidOrderCreate(orderId);
      allow update: if isAdmin() ||
        isCustomerCancelAction() ||
        isCustomerReturnAction() ||
        isServerVerifiedPaymentUpdate() ||
        isServerPaymentFailedUpdate();
      allow delete: if isAdmin();
    }

    // Reviews Collection
    // Public read; customer submission allowed; moderation and deletion admin-only
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Media Collection (Asset library metadata)
    // Public read; uploads and management strictly admin-only
    match /media/{mediaId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // FAQs Collection
    match /faqs/{faqId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Newsletter Subscribers
    match /newsletter/{subscriberId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    // Contact Inquiries
    match /contacts/{contactId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }
  }
}
